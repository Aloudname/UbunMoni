{
	"name": "ubunmoni",
	"displayName": "UbunMoni",
	"description": "Horizontal bottom-panel system monitor for Ubuntu servers: CPU, memory, storage I/O, disks and NVIDIA GPUs.",
	"publisher": "aloudname",
	"license": "Apache-2.0",
	"keywords": [
		"monitor",
		"system",
		"cpu",
		"memory",
		"disk",
		"gpu",
		"nvidia",
		"ubuntu",
		"linux"
	],
	"icon": "assets/icon.png",
	"version": "1.2.0",
	"engines": {
		"vscode": "^1.101.2"
	},
	"extensionKind": [
		"workspace"
	],
	"categories": [
		"Other"
	],
	"main": "./dist/extension.js",
	"scripts": {
		"vscode:prepublish": "webpack --mode production --devtool hidden-source-map",
		"compile": "webpack",
		"watch": "webpack --watch",
		"package": "webpack --mode production --devtool hidden-source-map",
		"lint": "eslint src --ext ts"
	},
	"devDependencies": {
		"@types/node": "18.19.115",
		"@types/vscode": "1.101.0",
		"@typescript-eslint/eslint-plugin": "6.21.0",
		"@typescript-eslint/parser": "6.21.0",
		"eslint": "8.57.1",
		"ts-loader": "9.5.2",
		"typescript": "5.8.3",
		"webpack": "5.99.9",
		"webpack-cli": "5.1.4"
	},
	"dependencies": {
		"systeminformation": "5.27.7"
	},
	"contributes": {
		"viewsContainers": {
			"panel": [
				{
					"id": "ubunmoni-monitor",
					"title": "System Monitor",
					"icon": "assets/panel-icon.svg"
				}
			]
		},
		"views": {
			"ubunmoni-monitor": [
				{
					"id": "ubunmoni.monitor",
					"name": "System Monitor",
					"type": "webview"
				}
			]
		},
		"commands": [
			{
				"command": "ubunmoni.open",
				"title": "Open Panel",
				"category": "System Monitor"
			}
		],
		"configuration": {
			"title": "UbunMoni",
			"properties": {
				"ubunmoni.refreshInterval": {
					"type": "number",
					"default": 1000,
					"minimum": 250,
					"maximum": 60000,
					"description": "Panel refresh interval in milliseconds."
				}
			}
		}
	}
}
